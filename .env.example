ALPACA_API_KEY=your_alpaca_api_key_here
ALPACA_SECRET_KEY=your_alpaca_secret_key_here
ALPACA_DATA_URL=https://data.alpaca.markets
TOSS_API_TOKEN=your_toss_api_token_here
TOSS_CLIENT_ID=your_toss_client_id_here
TOSS_CLIENT_SECRET=your_toss_client_secret_here
TOSS_ACCOUNT_SEQ=your_toss_account_seq_here
TOSS_BASE_URL=https://openapi.tossinvest.com
TOSS_ACCOUNT_SYNC_ENABLED=false
TOSS_LIVE_ORDER_ENABLED=false
TOSS_FAST_ORDER_ENABLED=false
DATA_GUARD_ENABLED=false
DAILY_TARGET_MIN_PCT=10
DAILY_TARGET_MAX_PCT=20
DAILY_LOSS_LIMIT_PCT=10
DAILY_PROFIT_LOCK_TRIGGER_PCT=20
DAILY_PROFIT_LOCK_GIVEBACK_PCT=10
DAILY_LOSS_LIMIT_USD=0
AUTO_SYMBOL_SELECTION_ENABLED=true
AUTO_SELECTION_MIN_PROBABILITY=55
AUTO_SELECTION_MIN_VOLUME_RATIO=1.2
AUTO_SELECTION_REQUIRE_RISK_NORMAL=true
TRADE_PREPARE_MODE=disabled
TRADE_APPROVAL_CHECKLIST_COMPLETE=false
AUTO_TRADE_MODE=disabled
AUTO_TRADE_KILL_SWITCH=true
AUTO_TRADE_PREAPPROVAL=false

# Alias names are also supported:
